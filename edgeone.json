{
  "buildCommand": "npm run build:site",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "work/deploy-site/public",
  "nodeVersion": "24.18.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 120,
      "externalNodeModules": [
        "sharp"
      ]
    }
  },
  "agents": {
    "dir": "agents",
    "runtime": "agent-node:1",
    "timeout": 120,
    "idleTimeout": 1800,
    "maxLifetime": 7200,
    "sandbox": {
      "timeout": 1800
    },
    "externalNodeModules": [
      "playwright"
    ]
  },
  "headers": [
    {
      "source": "/games/minecraft/play/index.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/games/minecraft/play/index.data",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/games/minecraft/play/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/games/minecraft/play/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/games/minidayz/play/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/games/minidayz/play/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
