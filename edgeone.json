{
  "buildCommand": "npm run build:site",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "work/deploy-site/public",
  "nodeVersion": "24.18.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 120,
      "externalNodeModules": [
        "sharp"
      ]
    }
  },
  "agents": {
    "dir": "agents",
    "runtime": "agent-node:1",
    "timeout": 120,
    "idleTimeout": 1800,
    "maxLifetime": 7200,
    "sandbox": {
      "timeout": 1800
    },
    "externalNodeModules": [
      "playwright"
    ]
  }
}
