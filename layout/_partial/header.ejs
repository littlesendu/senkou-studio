<% const studio = theme.studio && theme.studio.enabled ? theme.studio : null; const homeAnchor = id => homePage ? '#' + id : url_for('/') + '#' + id; %>
<header class="site-header">
  <a class="wordmark" href="<%= url_for('/') %>" aria-label="<%= studio ? studio.name : config.title %> 首页"><% if (studio) { %><span class="studio-logo" aria-hidden="true"><img src="<%= url_for('/assets/welkin/studio-logo.svg') %>" alt="" width="48" height="48"></span><% } %><span class="wordmark-copy"><span><%= studio ? studio.name : (config.title || 'Welkin').toUpperCase() %></span><small><% if (studio) { %><%= studio.english_name || 'SENKOU ESPORTS' %><% } else { %><%= config.subtitle || '' %><% } %></small></span></a>
  <nav aria-label="主导航">
    <% if (studio) { %>
    <a href="<%= homeAnchor('services') %>" data-section="services">组队服务</a>
    <a href="<%= homeAnchor('crew') %>" data-section="crew">认识小队</a>
    <a href="<%= homeAnchor('journal') %>" data-section="journal">工作室手记</a>
    <a class="nav-contact" href="<%= homeAnchor('contact') %>" data-section="contact">来组一队 <span aria-hidden="true">↗</span></a>
    <% } else { %>
    <a href="<%= url_for('/') %>" data-nav="home"<% if (homePage) { %> class="active" aria-current="page"<% } %>>首页</a>
    <a href="<%= homePage ? '#archive' : url_for('/' + config.archive_dir + '/') %>" data-nav="archive"<% if (is_archive()) { %> class="active" aria-current="true"<% } %>>所有文章</a>
    <a href="<%= url_for('/' + config.category_dir + '/') %>" data-nav="categories"<% if (is_category() || page.type === 'categories') { %> class="active" aria-current="true"<% } %>>分类</a>
    <% } %>
  </nav>
</header>
