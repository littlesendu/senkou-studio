<%
  const about = studio.about || {};
  const contact = studio.contact || {};
  const defaultTimeline = [
    { date: studio.idea_date, title: '一个想法，开始萌芽。', body: '最初提出森口电竞工作室的构想。' },
    { date: 'OUR SQUAD', title: '几个人，凑成一队。', body: '成员们并肩行动，把喜欢的游戏玩得更尽兴。' },
    { date: studio.launch_date, title: studio.launch_planned ? '计划正式成立。' : '工作室正式成立。', body: '把森口电竞的故事，继续写下去。', future: studio.launch_planned }
  ];
  const timeline = Array.isArray(about.timeline) && about.timeline.length ? about.timeline : defaultTimeline;
  const lines = value => String(value || '').split(/\r?\n/);
%>
<section id="about" class="studio-about studio-wrap" aria-labelledby="about-title"><div class="about-copy" data-reveal>
  <p class="studio-eyebrow"><%= about.eyebrow || '05 / OUR BEGINNING' %></p>
  <h2 id="about-title"><% lines(about.title || '从一个想法，\n到一起进场。').forEach((line, index, all) => { %><%= line %><% if (index < all.length - 1) { %><br><% } %><% }) %></h2>
  <p><% lines(about.intro || (studio.name + '的构想，始于 ' + studio.idea_date + '。\n围绕《' + studio.game + '》提供护航、娱乐和陪玩服务。')).forEach((line, index, all) => { %><%= line %><% if (index < all.length - 1) { %><br><% } %><% }) %></p>
  <p><% lines(about.story || '“森口”，代表我们认定的凶猛、可靠与一往无前。\n敢迎着挑战向前，也做队友可以信赖的后盾。').forEach((line, index, all) => { %><%= line %><% if (index < all.length - 1) { %><br><% } %><% }) %></p>
  <div class="studio-values"><img src="<%= url_for('/assets/welkin/studio-logo.svg') %>" alt="" width="46" height="46" loading="lazy"><span><strong><%= about.values_title || '凶猛 / 可靠 / 一往无前' %></strong><small><%= about.values_subtitle || 'FORWARD. TOGETHER.' %></small></span></div>
</div><ol class="studio-timeline">
  <% timeline.forEach((item, index) => { %><li data-reveal data-reveal-delay="<%= index * 80 %>"<% if (item.future) { %> class="timeline-future"<% } %>><span class="timeline-date"><%= item.date || '' %></span><div><h3><%= item.title || '' %><% if (item.future) { %><small>未来计划</small><% } %></h3><p><%= item.body || '' %></p></div></li><% }) %>
</ol></section>
<section id="contact" class="studio-contact studio-wrap" data-reveal aria-labelledby="contact-title"><div class="contact-kicker"><span class="studio-dot" aria-hidden="true"></span><%= contact.eyebrow || 'NEXT GAME / 下一场见' %></div><div class="contact-main"><h2 id="contact-title"><% lines(contact.title || '下次开局，\n算上我们。').forEach((line, index, all) => { %><%= line %><% if (index < all.length - 1) { %><br><% } %><% }) %></h2><div class="contact-details"><p><% lines(contact.description || '想打护航，轻松娱乐，还是找人陪玩？\n先聊聊你的想法，再约一场合拍的局。').forEach((line, index, all) => { %><%= line %><% if (index < all.length - 1) { %><br><% } %><% }) %></p><p class="contact-prompt"><%= contact.prompt || '点击下方按钮预约了解详情' %></p><a class="studio-text-link" href="<%= contact.url ? contact.url : url_for('/contact/') %>"><%= contact.link_label || '预约前先了解' %> <span aria-hidden="true">↗</span></a></div></div><div class="contact-bottom"><span><%= contact.bottom_left || '护航 / 娱乐 / 陪玩' %></span><span><%= contact.bottom_right || 'GOOD COMPANY, GOOD GAME.' %></span></div></section>
