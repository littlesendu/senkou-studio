<% const reviews = studio_customer_reviews(); const reviewOptions = studio.reviews || {}; %>
<section id="reviews" class="studio-reviews" aria-labelledby="reviews-title" data-review-repository="<%= reviewOptions.repository || '' %>" data-review-data="<%= url_for('/reviews/data.json') %>">
  <div class="studio-section-head studio-wrap" data-reveal><div><p class="studio-eyebrow">04 / KIND WORDS</p><h2 id="reviews-title">漂来的，是<span>你的回声。</span></h2></div><div class="reviews-heading-action"><p>留下一次同行的感受，<br>让下一位队友，多一份了解。</p><button class="review-open" type="button" data-review-open>投递一只评价瓶 <span aria-hidden="true">↗</span></button></div></div>
  <div class="reviews-water" aria-label="客户评价，悬停或聚焦可暂停" tabindex="0">
    <div id="review-streams" class="review-streams"<% if (!reviews.length) { %> hidden<% } %>><% [0, 1].forEach(row => { const items = reviews.filter((item, index) => index % 2 === row); if (!items.length) return; %><div class="review-lane"><div class="review-track" style="--drift-time:<%= 48 + row * 12 %>s"><% [0, 1].forEach(copy => { %><div class="review-group"<% if (copy) { %> aria-hidden="true" inert<% } %>><% items.forEach(item => { %><article class="review-bottle"><div><span><%= item.target %></span><%- partial('_partial/studio-rating', { rating: item.rating }) %></div><p><%= item.content %></p><small>一位同行的队友<% if (item.createdAt) { %> · <%= String(item.createdAt).slice(0, 10).replace(/-/g, '.') %><% } %></small></article><% }) %></div><% }) %></div></div><% }) %></div>
    <div id="reviews-empty" class="reviews-empty"<% if (reviews.length) { %> hidden<% } %>><svg width="40" height="65" viewBox="0 0 40 65" fill="none" aria-hidden="true"><path d="M16 4h10v15l8 11v25a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6V30l10-11V4Z" fill="#f8fbef99" stroke="currentColor"/><path d="M14 4h14M15 10h12M9 42c7-7 14 7 23 0M17 31l8 4-8 5v-9Z" stroke="currentColor" stroke-linecap="round"/></svg><p>第一只漂流瓶，等你投递。</p><small>这里会展示审核通过的真实评价。</small></div>
    <p class="reviews-pause-hint"><span aria-hidden="true">≈</span> 评价向右轻轻漂动 · 悬停或轻触可停留</p>
  </div>
  <dialog id="review-dialog" class="review-dialog" aria-labelledby="review-dialog-title"><button type="button" class="review-close" data-review-close aria-label="关闭评价窗口">×</button><p class="studio-eyebrow">A NOTE FROM YOU</p><h2 id="review-dialog-title">这一局，感觉如何？</h2><p class="review-dialog-intro">把真实的同行感受，装进一只小小的漂流瓶。</p><form id="review-form"><label>评价对象<select id="review-target" name="target" required><option value="">选择一位队友或工作室</option><option value="<%= studio.name %>"><%= studio.name %> · 整体服务</option><% studio.members.forEach(member => { %><option value="<%= member.name %>"><%= member.name %></option><% }) %></select></label><label>星级<select id="review-rating" name="rating" required><option value="5">★★★★★ · 5 星</option><option value="4">★★★★☆ · 4 星</option><option value="3">★★★☆☆ · 3 星</option><option value="2">★★☆☆☆ · 2 星</option><option value="1">★☆☆☆☆ · 1 星</option></select></label><label>内容<textarea id="review-content" name="content" required minlength="5" maxlength="300" rows="4" placeholder="这次同行有哪些值得记住的瞬间？（5–300 字）"></textarea></label><p id="review-submit-help" class="review-submit-help">评价审核通过后会展示，请勿填写联系方式或其他隐私信息。</p><button id="review-submit" class="studio-button" type="submit">提交评价 <span aria-hidden="true">↗</span></button><p id="review-status" role="status" aria-live="polite"></p></form></dialog>
  <noscript><p class="studio-wrap">评价投递需要开启 JavaScript。</p></noscript>
</section>
